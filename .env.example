# Copy to .env.local for local development (never commit .env.local).
# Neon CLI writes DATABASE_URL / DATABASE_URL_UNPOOLED / NEON_BRANCH for you.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
NEON_BRANCH=production

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DB_CONN_MAX_AGE=60
